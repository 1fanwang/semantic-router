            "type": "custom",
            "name": "code_exec",
            "description": "Run Python code.",
            "format": {
              "type": "text"
            }
          }
        ]
      }
    },
    {
      "name": "retained_call_output",
      "body": {
        "model": "client-model",
        "previous_response_id": "resp_previous_1",
        "input": [
          {
            "type": "custom_tool_call_output",
