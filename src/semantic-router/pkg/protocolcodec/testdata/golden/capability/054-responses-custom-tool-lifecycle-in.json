            "format": {
              "type": "grammar",
              "syntax": "lark",
              "definition": "start: begin_patch hunk end_patch\nbegin_patch: \"*** Begin Patch\" LF\nend_patch: \"*** End Patch\" LF?\nhunk: /(.|\\n)+/\n%import common.LF"
            }
          }
        ]
      }
    },
    {
